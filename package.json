{
  "name": "activity-card-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.39.6",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "prettier": "^3.6.2"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "proseWrap": "preserve",
    "printWidth": 80,
    "singleQuote": false,
    "quoteProps": "consistent",
    "singleAttributePerLine": true,
    "trailingComma": "all",
    "semi": false,
    "bracketSpacing": true,
    "arrowParens": "always",
    "objectWrap": "collapse",
    "experimentalTernaries": true,
    "bracketSameLine": false,
    "experimentalOperatorPosition": "start",
    "endOfLine": "lf"
  }
}
